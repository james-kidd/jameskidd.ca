{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jameskidd.info/schemas/experience.schema.json",
  "title": "Experience",
  "description": "One role: an internship, a leadership position or a freelance engagement. File: src/content/experience/<slug>.mdx. The body is the description, as Markdown bullets.",
  "x-schema-org": {
    "@type": "OrganizationRole",
    "maps": {
      "title": "roleName",
      "company": "worksFor.name (internships) or memberOf.name (academic)",
      "startDate": "startDate",
      "endDate": "endDate",
      "link": "worksFor.url or memberOf.url"
    },
    "note": "Freelance roles stay out of the Person graph."
  },
  "type": "object",
  "required": ["order", "group", "date", "title", "company", "skills"],
  "additionalProperties": false,
  "properties": {
    "order": { "type": "integer", "minimum": 0, "description": "Sort key within the group, lowest first." },
    "group": { "enum": ["internships", "academic", "freelance"], "description": "Must also exist in experienceGroups (src/data/sections/index.js)." },
    "date": { "type": "string", "minLength": 4, "description": "Display text, e.g. \"Jan 2026 — Apr 2026\"." },
    "title": { "type": "string", "minLength": 1 },
    "company": { "type": "string", "minLength": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "link": { "type": "string", "format": "uri" },
    "published": { "type": "boolean", "description": "false holds the role: file stays, nothing renders." },
    "startDate": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$" },
    "endDate": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$" }
  }
}
