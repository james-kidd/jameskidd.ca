{
  "$description": "Figma collection 'Shared / 03 Core' (one mode): medium-independent scalars plus Figma's legacy aliases (surface, text-strong, ...).",
  "surface": {
    "$type": "color",
    "$value": "{color.surface.default}",
    "$description": "Legacy name kept by Figma as an alias. Prefer --color-surface-default."
  },
  "text-strong": {
    "$type": "color",
    "$value": "{color.text.primary}",
    "$description": "Legacy name kept by Figma as an alias. Prefer --color-text-primary."
  },
  "text-muted": {
    "$type": "color",
    "$value": "{color.text.secondary}",
    "$description": "Legacy name kept by Figma as an alias. Prefer --color-text-secondary."
  },
  "accent-warn": {
    "$type": "color",
    "$value": "{color.status.warning}",
    "$description": "Legacy name kept by Figma as an alias. Prefer --color-status-warning."
  },
  "accent-highlight": {
    "$type": "color",
    "$value": "{color.accent.highlight}"
  },
  "status-success": {
    "$type": "color",
    "$value": "{color.status.success}"
  },
  "status-error": {
    "$type": "color",
    "$value": "{color.status.error}"
  },
  "status-info": {
    "$type": "color",
    "$value": "{color.status.info}"
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "4px. Matches Tailwind's --radius-sm, so rounded-sm is unchanged."
    },
    "md": {
      "$type": "dimension",
      "$value": "0.375rem",
      "$description": "6px. Matches Tailwind's --radius-md."
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "Signature panel radius. Overrides Tailwind's rounded-lg on purpose."
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "font-size": {
    "micro": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Smallest label size."
    },
    "eyebrow": {
      "$type": "dimension",
      "$value": "11px",
      "$description": "Uppercase eyebrow labels."
    },
    "body": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "Long-form prose size."
    },
    "10": {
      "$type": "dimension",
      "$value": "10px"
    },
    "11": {
      "$type": "dimension",
      "$value": "11px"
    },
    "12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "14": {
      "$type": "dimension",
      "$value": "14px"
    },
    "15": {
      "$type": "dimension",
      "$value": "15px"
    },
    "16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "18": {
      "$type": "dimension",
      "$value": "18px"
    },
    "20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "30": {
      "$type": "dimension",
      "$value": "30px"
    },
    "36": {
      "$type": "dimension",
      "$value": "36px"
    },
    "48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "60": {
      "$type": "dimension",
      "$value": "60px"
    },
    "72": {
      "$type": "dimension",
      "$value": "72px"
    }
  },
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "Geist",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Figma's UI face. Not loaded or used by the site yet: themes still set --font-family-sans (src/styles/legacy.css)."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      },
      "reading": {
        "$type": "fontFamily",
        "$value": [
          "Source Serif 4",
          "Georgia",
          "Times New Roman",
          "serif"
        ],
        "$description": "Long-form reading face (text medium). Not loaded yet."
      },
      "display-alternate": {
        "$type": "fontFamily",
        "$value": [
          "Space Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Optional display face. Not loaded yet."
      }
    }
  }
}
