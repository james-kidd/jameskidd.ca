{
  "$description": "Design tokens for jameskidd.info. Keys are the Figma variable names (group/name). scripts/build-tokens.mjs turns each one into a CSS custom property by swapping '/' for '-' (color/ink -> --color-ink) and writes app/tokens.css. Colours carry a light and a dark value; everything else has one value.",

  "color/surface":        { "$type": "color", "$value": { "light": "#faf9f6", "dark": "#0f1013" }, "$description": "Page background." },
  "color/surface-raised": { "$type": "color", "$value": { "light": "#ffffff", "dark": "#17181c" }, "$description": "Cards, demo panels, tags." },
  "color/ink":            { "$type": "color", "$value": { "light": "#1a1917", "dark": "#e8e6e1" }, "$description": "Headings and body text." },
  "color/ink-muted":      { "$type": "color", "$value": { "light": "#5f5e59", "dark": "#9c9a94" }, "$description": "Secondary text, labels, dates." },
  "color/line":           { "$type": "color", "$value": { "light": "#e5e3dd", "dark": "#27282d" }, "$description": "Borders and dividers." },
  "color/accent":         { "$type": "color", "$value": { "light": "#2650c8", "dark": "#8fb1ff" }, "$description": "Links, the primary button, active states, graph edges, map markers." },
  "color/accent-ink":     { "$type": "color", "$value": { "light": "#ffffff", "dark": "#0f1013" }, "$description": "Text on an accent background." },
  "color/overlay":        { "$type": "color", "$value": { "light": "#000000d9", "dark": "#000000e6" }, "$description": "Lightbox backdrop." },
  "color/on-overlay":     { "$type": "color", "$value": { "light": "#ffffff", "dark": "#ffffff" }, "$description": "Text and controls drawn over photos." },

  "font/sans": { "$type": "fontFamily", "$value": ["var(--font-plex-sans)", "IBM Plex Sans", "system-ui", "sans-serif"], "$description": "IBM Plex Sans, self-hosted by next/font in app/layout.tsx (which defines --font-plex-sans)." },
  "font/mono": { "$type": "fontFamily", "$value": ["var(--font-plex-mono)", "IBM Plex Mono", "ui-monospace", "monospace"], "$description": "IBM Plex Mono, same mechanism." },

  "radius/sm": { "$type": "dimension", "$value": "6px",  "$description": "Tags, buttons, filter chips." },
  "radius/md": { "$type": "dimension", "$value": "12px", "$description": "Cards, panels, photos, the demo frame." },

  "type/display":     { "$type": "dimension", "$value": "3.5rem",    "$description": "The name in the hero, desktop." },
  "type/display-min": { "$type": "dimension", "$value": "2.5rem",    "$description": "The name in the hero, phone." },
  "type/title":       { "$type": "dimension", "$value": "1.5rem",    "$description": "Section headings." },
  "type/lead":        { "$type": "dimension", "$value": "1.25rem",   "$description": "Hero tagline and section intros." },
  "type/heading":     { "$type": "dimension", "$value": "1.0625rem", "$description": "Role, project and card titles." },
  "type/body":        { "$type": "dimension", "$value": "1rem",      "$description": "Paragraphs." },
  "type/small":       { "$type": "dimension", "$value": "0.875rem",  "$description": "Descriptions, lists, tags." },
  "type/label":       { "$type": "dimension", "$value": "0.75rem",   "$description": "Uppercase mono labels: eyebrows, dates, nav." },
  "type/code":        { "$type": "dimension", "$value": "0.875rem",  "$description": "Mono at reading size: the typing animation, stats." }
}
