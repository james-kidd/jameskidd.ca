{
  "name": "jameskidd.ca",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-content.mjs --report",
    "dev": "vite",
    "tokens": "node scripts/build-tokens.mjs",
    "check-content": "node scripts/check-content.mjs",
    "approve": "node scripts/approve.mjs",
    "copy-deck": "node scripts/copy-deck.mjs",
    "copy-deck:check": "node scripts/copy-deck.mjs --check",
    "sync-briefs": "node scripts/sync-briefs.mjs",
    "sync-briefs:check": "node scripts/sync-briefs.mjs --check",
    "prebuild": "npm run tokens && npm run check-content",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-content": "node scripts/sync-content.mjs",
    "sync-content:check": "node scripts/sync-content.mjs --check"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "lucide-react": "^0.562.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.1",
    "react-simple-maps": "^3.0.0",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "react-simple-maps": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "estree-util-value-to-estree": "^3.5.0",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "papaparse": "^5.5.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "style-dictionary": "^5.5.1",
    "vite": "^7.2.4"
  }
}
